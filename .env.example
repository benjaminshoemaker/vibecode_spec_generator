# ─── AI PROVIDER ─────────────────────────────────────────────────────────────
# Which AI provider to use for chat and document generation.
# Options: openai (default) | local | openrouter
AI_PROVIDER=openai

# ─── OPENAI ──────────────────────────────────────────────────────────────────
# Required when AI_PROVIDER=openai (or when OPTIONS_PROVIDER=openai).
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ─── LOCAL (Ollama, LM Studio, or any OpenAI-compatible server) ───────────────
# Required when AI_PROVIDER=local.
# Point this at your local server's OpenAI-compatible /v1 endpoint.
#   Ollama default:     http://localhost:11434/v1
#   LM Studio default:  http://localhost:1234/v1
LOCAL_AI_BASE_URL=http://localhost:11434/v1

# API key for the local server. Most local servers accept any non-empty string.
# Leave blank or set to "local" if your server doesn't require authentication.
LOCAL_AI_API_KEY=local

# ─── OPENROUTER ───────────────────────────────────────────────────────────────
# Required when AI_PROVIDER=openrouter.
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ─── MAIN MODEL ───────────────────────────────────────────────────────────────
# The model used for chat and document generation. The name format depends on
# your chosen AI_PROVIDER:
#
#   openai:     OPENAI_MODEL=gpt-4o
#               OPENAI_MODEL=gpt-4o-mini
#
#   local:      OPENAI_MODEL=llama3.2:latest        (Ollama)
#               OPENAI_MODEL=mistral:7b-instruct    (Ollama)
#               OPENAI_MODEL=lmstudio-community/meta-llama-3.1-8b-instruct-GGUF  (LM Studio)
#
#   openrouter: OPENAI_MODEL=openai/gpt-4o
#               OPENAI_MODEL=anthropic/claude-3-5-sonnet
#               OPENAI_MODEL=google/gemini-2.0-flash-001
#               OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct
#               (full list at https://openrouter.ai/models)
OPENAI_MODEL=gpt-4o

# ─── OPTIONS PROVIDER & MODEL ─────────────────────────────────────────────────
# The multiple-choice options feature uses structured output (JSON schema), which
# not all models support. Use OPTIONS_PROVIDER to route options generation to a
# different provider than your main AI_PROVIDER — e.g. use a local model for
# chat but OpenAI for reliable structured output.
#
# Options: openai (default) | local | openrouter
# Defaults to AI_PROVIDER if not set.
OPTIONS_PROVIDER=openai

# Model for options generation when OPTIONS_PROVIDER=openai (default: gpt-4o).
# All gpt-4o and gpt-4-turbo variants support structured outputs.
OPENAI_OPTIONS_MODEL=gpt-4o-mini

# Model for options generation when OPTIONS_PROVIDER=local.
# Must support structured outputs (JSON schema). Not all local models do —
# test before relying on it. Recommended choices:
#   LOCAL_OPTIONS_MODEL=qwen2.5:7b          (strong structured output support)
#   LOCAL_OPTIONS_MODEL=llama3.1:8b         (good JSON support)
#   LOCAL_OPTIONS_MODEL=mistral:7b-instruct
LOCAL_OPTIONS_MODEL=qwen2.5:7b

# Model for options generation when OPTIONS_PROVIDER=openrouter.
# Choose a model with reliable JSON/structured output support.
# Recommended choices (fast + cheap + reliable):
#   OPENROUTER_OPTIONS_MODEL=openai/gpt-4o-mini
#   OPENROUTER_OPTIONS_MODEL=google/gemini-2.0-flash-001
#   OPENROUTER_OPTIONS_MODEL=anthropic/claude-3-5-haiku
OPENROUTER_OPTIONS_MODEL=openai/gpt-4o-mini

# ─── ANALYTICS (optional) ─────────────────────────────────────────────────────
# Google Analytics 4 measurement ID. Format: G-XXXXXXXXXX
# Get yours at: https://analytics.google.com/
NEXT_PUBLIC_GA_ID=

# Spikelog API key for custom event logging.
# Get yours at: https://spikelog.com
SPIKELOG_API_KEY=
